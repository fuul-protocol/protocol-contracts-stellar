{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "bun"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "fuul_*/**/*.ts",
    "support/**/*.ts"
  ]
}
